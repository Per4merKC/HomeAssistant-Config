---
# yamllint disable rule:key-ordering
substitutions:
  DEVICE_NAME: jarvis-ws1
  FRIENDLY_NAME: Jarvis Intervase (Waveshare 1)
  LOADING_COLOR: "000000"
  SCREEN_HEIGHT: "480"
  SCREEN_WIDTH: "800"

api:
  encryption:
    key: !secret esphome_encryption_key

captive_portal:

esp32:
  board: esp32-s3-devkitc-1
  framework:
    sdkconfig_options:
      CONFIG_ESP32S3_DATA_CACHE_64KB: y
      CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240: y
      CONFIG_SPIRAM_FETCH_INSTRUCTIONS: y
      CONFIG_SPIRAM_RODATA: y
    type: esp-idf
    version: recommended

esphome:
  friendly_name: ${FRIENDLY_NAME}
  name: ${DEVICE_NAME}
  on_boot:
    priority: 200
    then:
      - display.page.show: initializing_page
  #     lambda: |-
  #       id(my_ota).set_auth_password("950ab9aab37a99aa6eb18758e673f2a7");

i2c:
  id: bus_a
  scan: True
  scl: GPIO09
  sda: GPIO08

psram:
  mode: octal
  speed: 80MHz

display:
  - platform: rpi_dpi_rgb
    id: jarvis_display
    auto_clear_enabled: false
    color_order: RGB
    pclk_frequency: 16MHz
    dimensions:
      width: ${SCREEN_WIDTH}
      height: ${SCREEN_HEIGHT}
    de_pin:
      number: 5
    hsync_pin:
      number: 46
      ignore_strapping_warning: true
    vsync_pin:
      number: 3
      ignore_strapping_warning: true
    pclk_pin: 7
    hsync_back_porch: 30
    hsync_front_porch: 210
    hsync_pulse_width: 30
    vsync_back_porch: 4
    vsync_front_porch: 4
    vsync_pulse_width: 4
    data_pins:
      red:
        - 1 #r3
        - 2 #r4
        - 42 #r5
        - 41 #r6
        - 40 #r7
      blue:
        - 14 #b3
        - 38 #b4
        - 18 #b5
        - 17 #b6
        - 10 #b7
      green:
        - 39 #g2
        - 0 #g3
        - 45 #g4
        - 48 #g5
        - 47 #g6
        - 21 #g7
    pages:
      - id: initializing_page
        lambda: |-
          it.fill(id(loading_color));
          it.image((it.get_width() / 2), (it.get_height() / 2), id(jarvis_initializing), ImageAlign::CENTER);
      - id: idle_page
        lambda: |-
          it.fill(id(color_blue));
          it.print(10, 10, id(roboto_h1), id(color_teal), "Idle Page");

touchscreen:
  id: my_touch
  interrupt_pin: GPIO4
  on_touch:
    - lambda: |-
        ESP_LOGI("cal", "x=%d, y=%d, x_raw=%d, y_raw=%0d",
            touch.x,
            touch.y,
            touch.x_raw,
            touch.y_raw
            );
  platform: gt911

color:
  - id: color_blue
    blue_int: 255
    green_int: 0
    red_int: 0
    white_int: 0
  - id: color_teal
    blue_int: 255
    green_int: 255
    red_int: 0
    white_int: 0
  - id: color_orange
    blue_int: 18
    green_int: 156
    red_int: 243
    white_int: 0
  - id: loading_color
    hex: ${LOADING_COLOR}

font:
  - file:
      family: Roboto
      type: gfonts
      weight: 900
    id: roboto_h1
    size: 40
  - file:
      family: Roboto
      type: gfonts
      weight: 900
    id: roboto_body
    size: 20

globals:
  - id: init_in_progress
    initial_value: "true"
    restore_value: false
    type: bool

  - id: showing_fullscreen_image
    initial_value: "false"
    restore_value: no
    type: bool

image:
  - file: "images/loading.png"
    id: jarvis_initializing
    resize: ${SCREEN_HEIGHT}x${SCREEN_HEIGHT}
    type: RGB

logger:

ota:
  - platform: esphome
    password: !secret ota_password

script:
  - id: draw_display
    then:
      - if:
          condition:
            lambda: return !id(init_in_progress);
          then:
            - display.page.show: idle_page
            - component.update: jarvis_display
          else:
            - display.page.show: initializing_page
            - component.update: jarvis_display

time:
  - id: homeassistant_time
    platform: homeassistant

web_server:
  auth:
    password: !secret web_server_password
    username: !secret web_server_username
  include_internal: True
  port: 8080
  version: 3

wifi:
  ap:
    password: !secret ap_password
    ssid: "Jarvis-Display Fallback Hotspot"
  password: !secret wifi_password
  ssid: !secret wifi_ssid
